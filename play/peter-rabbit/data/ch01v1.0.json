    {
      "id": "l02",
      "speaker": "MUM",
      "en": "Don't go into the garden!",
      "zh": "别去菜园！",
      "audio": "l02"
    },
    {
      "id": "l03",
      "speaker": "MUM",
      "en": "Mr. McGregor is there.",
      "zh": "麦格雷戈先生在那儿。",
      "audio": "l03"
    },
    {
      "id": "l04",
      "speaker": "MUM",
      "en": "Here is my basket. Be good!",
      "zh": "这是我的篮子。要乖哦！",
      "audio": "l04"
    },
    {
      "id": "l05",
      "speaker": "NARR",
      "en": "The girls pick blackberries.",
      "zh": "三个姐姐去采黑莓。",
      "audio": "l05"
    },
    {
      "id": "l06",
      "speaker": "NARR",
      "en": "Peter runs to the garden.",
      "zh": "彼得却跑去了菜园。",
      "audio": "l06"
    },
    {
      "id": "l07",
      "speaker": "PETER",
      "en": "Shh! I'm in the garden!",
      "zh": "嘘！我进菜园啦！",
      "audio": "l07"
    },
    {
      "id": "l08",
      "speaker": "PETER",
